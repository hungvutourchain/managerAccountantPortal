  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 8000",
    "build": "ng build",
    "devlocal": "node --max_old_space_size=8096 node_modules/@angular/cli/bin/ng serve --open --port 8000 --watch=true --configuration development",
    "devconection": "node --max_old_space_size=10192 node_modules/@angular/cli/bin/ng serve --open --port 8000 --watch=true --configuration=connection",
    "minidev": "node --max_old_space_size=3800 node_modules/@angular/cli/bin/ng serve --port 4400 --watch=true --configuration=minidev",
    "fast": "ng serve --port 4400 --watch=true --configuration=minidev",
    "watch": "ng build --watch --configuration development",
    "build-prodvault": "node --max_old_space_size=8096 node_modules/@angular/cli/bin/ng build --configuration prodvault --aot=true  --base-href /vault/ --output-hashing=all",
    "build-prodbackend": "node --max_old_space_size=8096 node_modules/@angular/cli/bin/ng build --configuration prodbackend --aot=true  --base-href /backend/ --output-hashing=all",
    "build-prodmaster": "node --max_old_space_size=8096 node_modules/@angular/cli/bin/ng build --configuration prodmaster --aot=true  --base-href /master/ --output-hashing=all",
    "build-prodadmin": "node --max_old_space_size=8096 node_modules/@angular/cli/bin/ng build --configuration prodadmin --aot=true  --base-href /admin/ --output-hashing=all",
    "build-prodmanager": "node --max_old_space_size=8096 node_modules/@angular/cli/bin/ng build --configuration prodmanager --aot=true  --base-href /manager/ --output-hashing=all",
    "test": "ng test",
    "lint": "ng lint"
  },

{
  "ConnectionStrings": {
    "MongoDB": "mongodb://localhost:27017"
  },
  "DatabaseSettings": {
    "DatabaseName": "HotelTourPortal"
  },
  "AuditLog": {
    "RetentionDays": 365,
    "EnableCleanup": true,
    "CleanupIntervalHours": 24
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "HotelTourPortal.Api.Services.ServiceAuditLogService": "Information"
    }
  }
}
